    {
     "type": "html",
     "html": "<div style=\"font-family: sans-serif; width: 100%; box-sizing: border-box; overflow-x: auto;\">\n    <table style=\"width: 100%; border-collapse: collapse; border: 1px solid #ccc; font-size: 9.5px; background: #fff; table-layout: auto;\">\n        <thead>\n            <tr style=\"background-color: #f2f2f2; text-align: center;\">\n                <th style=\"border: 1px solid #ccc; padding: 4px;\">อรรถกถา</th>\n                <th style=\"border: 1px solid #ccc; padding: 4px;\">เอกวจนะ</th>\n                <th style=\"border: 1px solid #ccc; padding: 4px;\">พหุวจนะ</th>\n                <th style=\"border: 1px solid #ccc; padding: 4px;\">อายตนิบาต (คำแปลซึ่งเป็นคำเชื่อมต่อศัพท์)</th>\n            </tr>\n        </thead>\n        <tbody>\n            <tr>\n                <td style=\"border: 1px solid #ccc; padding: 4px;\">ปจฺจตฺต</td>\n                <td style=\"border: 1px solid #ccc; padding: 4px; text-align: center;\">สิ</td>\n                <td style=\"border: 1px solid #ccc; padding: 4px; text-align: center;\">โย</td>\n                <td style=\"border: 1px solid #ccc; padding: 4px;\">อันว่า..... (อ.), อันว่า.....ทั้งหลาย (อ. ...... ท.)</td>\n            </tr>\n            <tr>\n                <td style=\"border: 1px solid #ccc; padding: 4px;\">อาลปน</td>\n                <td style=\"border: 1px solid #ccc; padding: 4px; text-align: center;\">สิ</td>\n                <td style=\"border: 1px solid #ccc; padding: 4px; text-align: center;\">โย</td>\n                <td style=\"border: 1px solid #ccc; padding: 4px;\">แน่ะ, ดูก่อน, ข้าแต่</td>\n            </tr>\n            <tr>\n                <td style=\"border: 1px solid #ccc; padding: 4px;\">อุปโยค</td>\n                <td style=\"border: 1px solid #ccc; padding: 4px; text-align: center;\">งํ</td>\n                <td style=\"border: 1px solid #ccc; padding: 4px; text-align: center;\">โย</td>\n                <td style=\"border: 1px solid #ccc; padding: 4px;\">ซึ่ง, สู่, ยัง, สิ้น, ตลอด, กะ, เฉพาะ</td>\n            </tr>\n            <tr>\n                <td style=\"border: 1px solid #ccc; padding: 4px;\">กรณ</td>\n                <td style=\"border: 1px solid #ccc; padding: 4px; text-align: center;\">นา</td>\n                <td style=\"border: 1px solid #ccc; padding: 4px; text-align: center;\">หิ</td>\n                <td style=\"border: 1px solid #ccc; padding: 4px;\">ด้วย, โดย, อัน, ตาม, (ข้าง, ทาง), เพราะ, มี, ด้วยทั้ง</td>\n            </tr>\n            <tr>\n                <td style=\"border: 1px solid #ccc; padding: 4px;\">สมฺปทาน</td>\n                <td style=\"border: 1px solid #ccc; padding: 4px; text-align: center;\">ส</td>\n                <td style=\"border: 1px solid #ccc; padding: 4px; text-align: center;\">นํ</td>\n                <td style=\"border: 1px solid #ccc; padding: 4px;\">แก่, เพื่อ, ต่อ</td>\n            </tr>\n            <tr>\n                <td style=\"border: 1px solid #ccc; padding: 4px;\">นิสฺสกฺก</td>\n                <td style=\"border: 1px solid #ccc; padding: 4px; text-align: center;\">สฺมา</td>\n                <td style=\"border: 1px solid #ccc; padding: 4px; text-align: center;\">หิ</td>\n                <td style=\"border: 1px solid #ccc; padding: 4px;\">แต่, จาก, กว่า, เหตุ, เพราะ</td>\n            </tr>\n            <tr>\n                <td style=\"border: 1px solid #ccc; padding: 4px;\">สามี</td>\n                <td style=\"border: 1px solid #ccc; padding: 4px; text-align: center;\">ส</td>\n                <td style=\"border: 1px solid #ccc; padding: 4px; text-align: center;\">นํ</td>\n                <td style=\"border: 1px solid #ccc; padding: 4px;\">แห่ง, ของ, เมื่อ</td>\n            </tr>\n            <tr>\n                <td style=\"border: 1px solid #ccc; padding: 4px;\">ภุมฺม</td>\n                <td style=\"border: 1px solid #ccc; padding: 4px; text-align: center;\">สฺมึ</td>\n                <td style=\"border: 1px solid #ccc; padding: 4px; text-align: center;\">สุ</td>\n                <td style=\"border: 1px solid #ccc; padding: 4px;\">ใน, ใกล้, ที่, ครั้นเมื่อ, ในเพราะ, เหนือ, บน, ณ</td>\n            </tr>\n        </tbody>\n    </table>\n</div>"
