  {
   "id": "c1791180200379",
   "title": "สนธิกัณฑ์",
   "blocks": [
    {
     "type": "heading",
     "level": "h2",
     "html": "สนธิกัณฑ์"
    },
    {
     "type": "items",
     "wrap": "div",
     "items": [
      {
       "html": "วิธิสูตรมี ๘ ประการ"
      }
     ]
    },
    {
     "type": "html",
     "html": "<div style=\"font-family: sans-serif; line-height: 1.6; color: #333; padding: 10px;\">\n<ol style=\"padding-left: 20px; margin: 0;\">\n<li style=\"margin-bottom: 6px;\">โลปวิธิ</li>\n<li style=\"margin-bottom: 6px;\">อาเทสวิธิ</li>\n<li style=\"margin-bottom: 6px;\">อาคมวิธิ</li>\n<li style=\"margin-bottom: 6px;\">ทีฆวิธิ</li>\n<li style=\"margin-bottom: 6px;\">รัสสวิธิ</li>\n<li style=\"margin-bottom: 6px;\">นิเสธวิธิ</li>\n<li style=\"margin-bottom: 6px;\">วิภัตติวิธิ</li>\n<li style=\"margin-bottom: 6px;\">ปัจจยวิธิ</li>\n</ol>\n</div>"
    },
    {
     "type": "heading",
     "level": "h3",
     "html": "วาศัพท์ที่มีอรรถ ววตฺถิตวิภาสา"
    },
    {
     "type": "html",
     "html": "<div style=\"font-family: sans-serif; line-height: 1.6; color: #333; padding: 10px;\">\n   <ol style=\"padding-left: 20px; margin: 0;\">\n        <li style=\"margin-bottom: 8px;\"><strong>นิจฺจวิธิ</strong> วิธีที่แน่นอน</li>\n        <li style=\"margin-bottom: 8px;\"><strong>อนิจฺจวิธิ</strong> วิธีที่ไม่แน่นอน</li>\n        <li style=\"margin-bottom: 8px;\"><strong>อสนฺตวิธิ</strong> วิธีที่ไม่มีในสูตร</li>\n    </ol>\n</div>"
    },
    {
     "type": "heading",
     "level": "h3",
     "html": "อธิการนย : นัยแห่งการตามไป มี ๓ ประการ"
    },
    {
     "type": "html",
     "html": "<div style=\"font-family: sans-serif; line-height: 1.6; color: #333; padding: 10px;\">\n    <ol style=\"padding-left: 20px; margin: 0;\">\n        <li style=\"margin-bottom: 8px;\">สีหคติกอธิการนัย</li>\n        <li style=\"margin-bottom: 8px;\">มณฺฑูกคติกอธิการนัย</li>\n        <li style=\"margin-bottom: 8px;\">นทีโสตคติกอธิการนัย</li>\n    </ol>\n</div>"
    }
   ],
